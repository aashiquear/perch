<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Perch</string>
    <key>CFBundleShortVersionString</key>
    <string>0.9.2</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Perch finds and controls perchd hosts on your local network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_perch._tcp</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Perch can read head motion from Bluetooth headphones to keep windows fixed in space.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>A page in a Perch window (voice chat in a cloud game, a call) asked for the microphone.</string>
    <key>NSCameraUsageDescription</key>
    <string>A page in a Perch window asked for the camera.</string>
    <key>NSMotionUsageDescription</key>
    <string>Perch can use head-tracking earphones to keep windows fixed in space.</string>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
</dict>
</plist>
